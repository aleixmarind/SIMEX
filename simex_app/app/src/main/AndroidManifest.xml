<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Simex_app"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".ui.screens.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.screens.HomePageAgenteActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.HomePageClienteActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.ComandasActivity"
            android:exported="false"
            android:label="Mis Comandas" />

        <activity
            android:name=".ui.screens.DetalleComandaActivity"
            android:exported="false"
            android:label="Detalle de Comanda" />

        <activity
            android:name=".ui.screens.OfertasActivity"
            android:exported="false"
            android:label="Mis Ofertas" />

        <activity
            android:name=".ui.screens.PerfilActivity"
            android:exported="false"
            android:label="Mi Perfil" />

        <activity
            android:name=".ui.screens.DetalleComandaAgenteActivity"
            android:exported="false"
            android:label="Gestión de Comanda" />

    </application>

</manifest>